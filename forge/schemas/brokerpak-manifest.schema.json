{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/alex-tw-lam/brokerpak-forge/brokerpak-manifest.schema.json",
  "title": "CSB brokerpak manifest",
  "description": "Derived from cloud-service-broker internal/brokerpak/manifest Go structs and validated against the official AWS/Azure/GCP brokerpak manifests.",
  "type": "object",
  "required": ["packversion", "name", "version", "platforms", "terraform_binaries", "service_definitions"],
  "additionalProperties": false,
  "properties": {
    "packversion": { "type": "integer" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["os", "arch"],
        "additionalProperties": false,
        "properties": {
          "os": { "type": "string", "enum": ["linux", "darwin", "windows"] },
          "arch": { "type": "string", "enum": ["amd64", "arm64", "386"] }
        }
      }
    },
    "terraform_binaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "source": { "type": "string" },
          "provider": { "type": "string", "minLength": 3 },
          "url_template": { "type": "string" },
          "default": { "type": "boolean" }
        }
      }
    },
    "service_definitions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "required_env_vars": {
      "type": "array",
      "items": { "type": "string" }
    },
    "env_config_mapping": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "terraform_upgrade_path": {
      "type": "array",
      "items": { "oneOf": [ { "type": "string" }, { "type": "object" } ] }
    },
    "terraform_state_provider_replacements": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
