{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/alex-tw-lam/brokerpak-forge/service-definition.schema.json",
  "title": "CSB service definition",
  "description": "Derived from the cloud-service-broker Go structs (pkg/brokerpak/manifest, internal service definition loading) and validated against the official AWS/Azure/GCP brokerpak definitions.",
  "type": "object",
  "required": ["version", "name", "id", "description", "display_name", "provision", "bind"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "id": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "display_name": { "type": "string" },
    "image_url": { "type": "string" },
    "documentation_url": { "type": "string" },
    "support_url": { "type": "string" },
    "provider_display_name": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "plan_updateable": { "type": "boolean" },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "id", "description"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "id": { "type": "string" },
          "description": { "type": "string" },
          "display_name": { "type": "string" },
          "metadata": { "type": "object" },
          "free": { "type": "boolean" },
          "properties": { "type": "object" }
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": true
      }
    },
    "provision": { "$ref": "#/definitions/side" },
    "bind": { "$ref": "#/definitions/side" }
  },
  "definitions": {
    "side": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan_inputs": { "type": "array", "items": { "$ref": "#/definitions/input" } },
        "user_inputs": { "type": "array", "items": { "$ref": "#/definitions/input" } },
        "computed_inputs": { "type": "array", "items": { "$ref": "#/definitions/computed" } },
        "template_refs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field_name", "type"],
            "additionalProperties": false,
            "properties": {
              "field_name": { "type": "string" },
              "type": { "$ref": "#/definitions/valuetype" },
              "details": { "type": "string" },
              "required": { "type": "boolean" },
              "constraints": {
                "type": "object",
                "properties": {
                  "minLength": { "type": "integer" },
                  "maxLength": { "type": "integer" },
                  "pattern": { "type": "string" }
                },
                "additionalProperties": true
              }
            }
          }
        }
      }
    },
    "input": {
      "type": "object",
      "required": ["field_name", "type"],
      "additionalProperties": false,
      "properties": {
        "field_name": { "type": "string" },
        "type": { "$ref": "#/definitions/valuetype" },
        "details": { "type": "string" },
        "required": { "type": "boolean" },
        "nullable": { "type": "boolean" },
        "default": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "object" },
            { "type": "array" },
            { "type": "null" }
          ]
        },
        "enum": { "type": "object" },
        "constraints": {
          "type": "object",
          "properties": {
            "minLength": { "type": "integer" },
            "maxLength": { "type": "integer" },
            "pattern": { "type": "string" }
          },
          "additionalProperties": true
        },
        "prohibit_update": { "type": "boolean" },
        "plan_updateable": { "type": "boolean" }
      }
    },
    "computed": {
      "type": "object",
      "required": ["name", "default"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "default": { "type": "string" },
        "type": { "$ref": "#/definitions/valuetype" },
        "details": { "type": "string" },
        "required": { "type": "boolean" },
        "overwrite": { "type": "boolean" }
      }
    },
    "valuetype": {
      "type": "string",
      "enum": ["string", "number", "integer", "boolean", "timestamp", "object", "array", "json", "credential", "rsa-public-key", "uuid"]
    }
  }
}
